function getPrice(p){return p.disc && p.disc < p.v? p.disc : p.v}

// دالة عرض المتجر مع دعامة البوم الميديا التفاعلي (صور وفيديوهات)
function drawStore(){
  grid.innerHTML='';
  PROD.forEach((x, prodIdx)=>{
    let priceHtml = x.disc && x.disc < x.v
      ? `<div class="price"><span style="text-decoration:line-through;color:var(--muted);font-size:14px">${x.v}</span> ${x.disc} ${i18n[LANG].currency}</div>`
      : `<div class="price">${x.v} ${i18n[LANG].currency}</div>`;
    let stockHtml = x.showStock && x.stock>0? `<div class="stock ${x.stock<5?'low':''}"> ${LANG=='ar'?'متبقي':'Remaining'} ${x.stock} ${i18n[LANG].pcs}</div>` : x.showStock && x.stock==0? `<div class="stock low">${LANG=='ar'?'نفذت الكمية':'Out of Stock'}</div>` : '';
    let btnDisabled = x.stock<=0? 'disabled' : '';
    
    // بناء الألبوم التفاعلي للمنتج
    let mediaList = x.media || [];
    if(mediaList.length === 0) mediaList = [{type:'image', src:'https://via.placeholder.com/200'}];
    
    let mediaItemsHtml = mediaList.map((m, i) => {
      let activeClass = i === 0 ? 'active' : '';
      if(m.type === 'video') {
        return `<video src="${m.src}" class="media-item-${prodIdx} ${activeClass}" controls muted></video>`;
      } else {
        return `<img src="${m.src}" class="media-item-${prodIdx} ${activeClass}">`;
      }
    }).join('');

    let navHtml = mediaList.length > 1 ? `
      <button class="media-nav prev" onclick="slideMedia(${prodIdx}, -1)">&#10095;</button>
      <button class="media-nav next" onclick="slideMedia(${prodIdx}, 1)">&#10094;</button>
    ` : '';

    grid.innerHTML+=`
      <div class="card">
        <div class="media-container" id="mediaCont${prodIdx}">
          ${mediaItemsHtml}
          ${navHtml}
        </div>
        <h4>${x.n}</h4>
        <p>${x.d.substring(0,40)}...</p>
        ${priceHtml}
        ${stockHtml}
        <button class="btn" onclick="addC(${x.id})" ${btnDisabled}>${LANG=='ar'?'اضف للسلة':'Add to Cart'}</button>
      </div>`;
  });
}

// دالة التحكم بتقليب الصور والفيديوهات في كرت المنتج
function slideMedia(prodIdx, direction) {
  let container = document.getElementById(`mediaCont${prodIdx}`);
  let items = container.querySelectorAll(`.media-item-${prodIdx}`);
  let activeIdx = Array.from(items).findIndex(el => el.classList.contains('active'));
  
  items[activeIdx].classList.remove('active');
  // إيقاف الفيديو مؤقتاً لو تم الانتقال لملف آخر
  if(items[activeIdx].tagName === 'VIDEO') items[activeIdx].pause();

  let nextIdx = activeIdx + direction;
  if(nextIdx >= items.length) nextIdx = 0;
  if(nextIdx < 0) nextIdx = items.length - 1;
  
  items[nextIdx].classList.add('active');
}

function addC(id){let p=PROD.find(x=>x.id==id);if(p.stock<=0)return toast(i18n[LANG].item_out);CART[id]=(CART[id]||0)+1;if(!CHK_OPTS[id])CHK_OPTS[id]={q:1,sz:'',cl:''};CHK_OPTS[id].q=CART[id];updC();toast(i18n[LANG].added_cart)}
function delC(id){delete CART[id];delete CHK_OPTS[id];updC()}
function chgQty(id,d){let p=PROD.find(x=>x.id==id);let newQ=CART[id]+d;if(newQ<=0){delC(id);return}if(newQ>p.stock)return toast(`${i18n[LANG].max_stock}: ${p.stock}`);CART[id]=newQ;CHK_OPTS[id].q=CART[id];updC()}

function updC(){
  let items=Object.keys(CART).map(id=>({id:+id,p:PROD.find(x=>x.id==+id),q:CART[id]}));
  let total=items.reduce((a,b)=>a+b.q,0);
  cNum.innerText=total;cNum2.innerText=total;
  cItems.innerHTML=items.map(x=>{
    let firstMedia = x.p.media && x.p.media[0] ? x.p.media[0] : {type:'image', src:'https://via.placeholder.com/200'};
    let previewTag = firstMedia.type === 'video' 
      ? `<video src="${firstMedia.src}" muted></video>` 
      : `<img src="${firstMedia.src}">`;
    return `
    <div class="cart-item">
      ${previewTag}
      <div style="flex:1"><b>${x.p.n}</b><br><span style="color:var(--muted)">${getPrice(x.p)} ${i18n[LANG].currency}</span></div>
      <div class="qty">
        <button class="btn small gray" onclick="chgQty(${x.id},-1)">-</button>
        <b>${x.q}</b>
        <button class="btn small gray" onclick="chgQty(${x.id},1)">+</button>
      </div>
      <button class="btn small red" onclick="delC(${x.id})">X</button>
    </div>`}).join('')||`<p style="text-align:center;color:var(--muted)">${i18n[LANG].empty_cart}</p>`;
}
function cartToggle(){cart.style.display=cart.style.display=='block'?'none':'block'}

function toCheckout(){
  if(!Object.keys(CART).length)return alert(i18n[LANG].empty_cart);
  cartToggle();
  checkList.innerHTML=Object.keys(CART).map(id=>{
    let p=PROD.find(x=>x.id==+id);
    if(!CHK_OPTS[id])CHK_OPTS[id]={q:CART[id],sz:p.sz[0]||'',cl:p.cl[0]||''};
    let opt=CHK_OPTS[id];
    let price = getPrice(p);
    let szHtml=p.sz.length?`<div class="sz-group"><h4>${i18n[LANG].sizes}:</h4><div style="display:flex;flex-wrap:wrap">${p.sz.map(s=>{
      let st=p.stockBySize[s]??0;
      let dis=st<=0?'disabled':'';
      return `<span class="opt-btn ${s==opt.sz?'active':''} ${dis}" onclick="setOpt(${id},'sz','${s}',this)">${s}</span>`
    }).join('')}</div></div>`:'';
    let clHtml=p.cl.length?`<div class="cl-group"><h4>${i18n[LANG].colors}:</h4><div style="display:flex;flex-wrap:wrap">${p.cl.map(c=>{
      let st=p.stockByColor[c]??0;
      let dis=st<=0?'disabled':'';
      return `<span class="opt-btn ${c==opt.cl?'active':''} ${dis}" onclick="setOpt(${id},'cl','${c}',this)">${c}</span>`
    }).join('')}</div></div>`:'';
    
    let firstMedia = p.media && p.media[0] ? p.media[0] : {type:'image', src:'https://via.placeholder.com/200'};
    let mediaTag = firstMedia.type === 'video' ? `<video src="${firstMedia.src}" controls muted></video>` : `<img src="${firstMedia.src}">`;

    return `<div class="check-prod" id="chk${id}">${mediaTag}<h3>${p.n}</h3><p style="color:var(--muted);line-height:1.7">${p.d}</p>${szHtml}${clHtml}<h4>${LANG=='ar'?'الكمية':'Qty'}: ${opt.q}</h4><h3 style="color:var(--main)">${i18n[LANG].th_price}: ${price*opt.q} ${i18n[LANG].currency}</h3></div>`
  }).join('');
  cg.innerHTML=`<option value="">${i18n[LANG].select_gov}</option>`+SET.gov.map(g=>`<option value="${g.v}">${g.n} - ${g.v} ${i18n[LANG].currency}</option>`).join('');
  cg.onchange=calc; COUPON=0;coupon.value='';cpBox.style.display=SET.cpOn?'flex':'none';calc();
  go('checkout')
}
function setOpt(id,key,val,el){
  if(el.classList.contains('disabled'))return toast(i18n[LANG].item_out);
  CHK_OPTS[id][key]=val;
  let group = key=='sz'? el.closest('.sz-group') : el.closest('.cl-group');
  group.querySelectorAll('.opt-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
}
function calc(){
  let sub=0;
  Object.keys(CART).forEach(id=>{
    let p=PROD.find(x=>x.id==+id);
    sub+=getPrice(p)*CHK_OPTS[id].q;
  });
  let ship=+cg.value||0;
  let discountAmount = sub * (COUPON / 100);
  LAST={sub,ship,tot:sub+ship-discountAmount};
  sum.innerHTML=`<hr><table style="background:transparent">
    <tr><td>${LANG=='ar'?'المنتجات':'Products'}</td><td><b>${sub}</b></td></tr>
    <tr><td>${LANG=='ar'?'الشحن':'Shipping'}</td><td><b>${ship}</b></td></tr>
    ${COUPON>0?`<tr><td>${LANG=='ar'?'خصم الكوبون':'Coupon Discount'}</td><td><b style="color:var(--green)">-%${COUPON} (-${discountAmount.toFixed(1)})</b></td></tr>`:''}
    <tr><td><b>${i18n[LANG].total_lbl}</b></td><td><b style="color:var(--main);font-size:20px">${LAST.tot.toFixed(1)} ${i18n[LANG].currency}</b></td></tr></table>`;
}
function applyCoupon(){if(coupon.value==SET.cpCode){COUPON=+SET.cpVal;toast(`%${COUPON} OK`)}else{COUPON=0;toast('Error')};calc()}
function finish(){
  if(!cn.value||!cp.value||!ca.value||!cg.value)return alert('.. Data');
  let items=[];
  for(let id in CART){
    let p=PROD.find(x=>x.id==+id);
    let opt=CHK_OPTS[id];
    if(p.sz.length&&!opt.sz)return toast(`${i18n[LANG].select_size} ${p.n}`);
    if(p.cl.length&&!opt.cl)return toast(`${i18n[LANG].select_color} ${p.n}`);
    if(opt.q>p.stock)return toast(`${i18n[LANG].max_stock} ${p.stock}`);
    
    items.push({id:+id,n:p.n,v:getPrice(p),cost:p.cost||0,...opt});
    p.stock-=opt.q;
    if(p.stockByColor[opt.cl])p.stockByColor[opt.cl]-=opt.q;
    if(p.stockBySize[opt.sz])p.stockBySize[opt.sz]-=opt.q;
  }
  ORD.unshift({id:Date.now(),date:new Date().toLocaleString(LANG==='ar'?'ar-EG':'en-US'),c:{n:cn.value,p:cp.value,a:ca.value,g:cg.options[cg.selectedIndex].text},items,tot:LAST.tot,st:'new'});
  saveAll();CART={};CHK_OPTS={};COUPON=0;updC();toast(i18n[LANG].ordered_msg);cn.value=cp.value=ca.value='';go('store')
}

// دالة قراءة ومعالجة ملفات الميديا المتعددة المرفوعة
pi.onchange = e => {
  let files = Array.from(e.target.files);
  if(!files.length) return;
  
  files.forEach(file => {
    let type = file.type.startsWith('video/') ? 'video' : 'image';
    let r = new FileReader();
    r.onload = ev => {
      TMP_MEDIA.push({ type: type, src: ev.target.result });
      renderPreviewGallery();
    };
    r.readAsDataURL(file);
  });
};

function renderPreviewGallery() {
  previewGallery.innerHTML = TMP_MEDIA.map((m, idx) => `
    <div class="preview-item">
      ${m.type === 'video' ? `<video src="${m.src}" muted></video>` : `<img src="${m.src}">`}
      <button class="remove-btn" onclick="removeMediaFromTmp(${idx})">X</button>
    </div>
  `).join('');
}

function removeMediaFromTmp(idx) {
  TMP_MEDIA.splice(idx, 1);
  renderPreviewGallery();
}

